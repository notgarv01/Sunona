{
  "name": "sunona",
  "productName": "SunoNa",
  "version": "1.0.10",
  "description": "SunoNa - Modern YouTube Music Desktop Client",
  "author": "Garv <garv@sunona.app>",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "electron . --dev",
    "electron:build": "tsc -b && vite build && electron-builder --win"
  },
  "dependencies": {
    "@distube/ytdl-core": "^5.0.1",
    "electron-updater": "^6.8.11",
    "firebase": "^13.2.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "com.garv.sunona",
    "productName": "SunoNa",
    "publish": {
      "provider": "github",
      "owner": "notgarv01",
      "repo": "Sunona"
    },
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/sunona.ico",
      "public/icon-512.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/sunona.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "public/icon-512.png",
      "identity": null
    },
    "dmg": {
      "title": "SunoNa",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SunoNa",
      "uninstallDisplayName": "SunoNa Music"
    }
  }
}
